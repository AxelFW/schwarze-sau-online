function QuetschSelect({names,quetschStep,hand,onConfirm}) {
  const [sel,setSel]=useState([]);
  const toggle=(card)=>setSel(prev=>{
    const already=prev.find(c=>c.s===card.s&&c.v===card.v);
    if(already) return prev.filter(c=>!(c.s===card.s&&c.v===card.v));
    if(prev.length>=3) return prev;
    return [...prev,card];
  });
  const isSelected=card=>!!sel.find(c=>c.s===card.s&&c.v===card.v);
  const target=names[(quetschStep+1)%4];
  return (
    <div style={{...bg,display:'flex',flexDirection:'column'}}>
      <div style={{background:'rgba(0,0,0,0.5)',padding:'10px 16px',display:'flex',justifyContent:'space-between',alignItems:'center',flexShrink:0}}>
        <span style={{color:'#f4c430',fontWeight:'bold',fontSize:17,letterSpacing:1}}>🐷 Wuzz</span>
        <span style={{background:'rgba(244,196,48,0.15)',border:'1px solid rgba(244,196,48,0.35)',borderRadius:8,padding:'3px 12px',fontSize:12,color:'#f4c430'}}>QUETSCH {quetschStep+1}/4</span>
      </div>
      <div style={{flexShrink:0,background:'rgba(0,0,0,0.4)',padding:'12px 16px',borderBottom:'1px solid rgba(255,255,255,0.07)'}}>
        <div style={{textAlign:'center',marginBottom:10}}>
          <span style={{color:'#f4c430',fontWeight:'bold',fontSize:15}}>👤 {names[quetschStep]}</span>
          <span style={{color:'#9dcfb0',fontSize:13,marginLeft:10}}>→ 3 Karten an <strong style={{color:'white'}}>{target}</strong></span>
        </div>
        <div style={{display:'flex',justifyContent:'center',gap:8,alignItems:'center',flexWrap:'wrap'}}>
          {[0,1,2].map(i=>(
            <div key={i} style={{width:46,height:64,borderRadius:6,border:`2px solid ${sel[i]?'#f4c430':'rgba(255,255,255,0.12)'}`,background:sel[i]?'rgba(244,196,48,0.08)':'rgba(255,255,255,0.03)',display:'flex',alignItems:'center',justifyContent:'center',fontSize:11,color:sel[i]?'#f4c430':'rgba(255,255,255,0.18)'}}>
              {sel[i]?<CardFace card={sel[i]} size='sm'/>:'?'}
            </div>
          ))}
          <Btn onClick={()=>sel.length===3&&onConfirm(sel)} disabled={sel.length!==3} style={{marginLeft:8,fontSize:15,padding:'10px 22px'}}>
            Weitergeben →
          </Btn>
        </div>
        <div style={{textAlign:'center',marginTop:7,fontSize:11,color:'rgba(255,255,255,0.28)'}}>{sel.length}/3 ausgewählt</div>
      </div>
      <div style={{flex:1,overflowY:'auto',padding:'14px 12px'}}>
        <div style={{display:'flex',flexWrap:'wrap',gap:8,justifyContent:'center'}}>
          {hand.map(card=>(
            <CardFace key={`${card.s}${card.v}`} card={card}
              selected={isSelected(card)} highlighted={!isSelected(card)&&sel.length<3}
              onClick={()=>toggle(card)}/>
          ))}
        </div>
        <p style={{textAlign:'center',fontSize:11,color:'rgba(255,255,255,0.28)',marginTop:12}}>Tippe zum Auswählen</p>
      </div>
    </div>
  );
}

