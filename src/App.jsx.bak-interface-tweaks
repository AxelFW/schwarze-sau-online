// ═══════════════════════════════════════════════════════════════════════════════
export default function App() {
  const [names,setNames] = useState(() => randomLocalSeatNames());
  const [seatTypes,setSeatTypes] = useState(['human','heuristic','heuristic','heuristic']);
  const isBot = seatTypes.map(isComputerSeat);
  const [screen,setScreen]   = useState('welcome');
  const [scores,setScores]   = useState([0,0,0,0]);
  const [round,setRound]     = useState(1);
  const [gs,setGs]           = useState(null);
  const [phase,setPhase]     = useState('pass');
  const [lastTrick,setLastTrick] = useState(null);
  const [quetschStep,setQuetschStep] = useState(0);
  const [quetschReceived,setQuetschReceived] = useState([[],[],[],[]]);
  const [quetschReviewQueue,setQuetschReviewQueue] = useState([]);
  const [quetschReviewPos,setQuetschReviewPos] = useState(0);
  const [botBusy,setBotBusy] = useState(false);
  const [botError,setBotError] = useState(null);
  const MAX = 8;
  const TRICK_DONE_AUTO_ADVANCE_MS = 1400;

  // ── Play a card (human or bot) ─────────────────────────────────────────────
  const commitCard = useCallback((prevGs, player, card) => {
    const newGs = applyCard(prevGs, player, card);
    if(!newGs) return;
    if(newGs._trickJustFinished) {
      const tp = newGs.tricksPlayed;
      setGs(newGs);
      setLastTrick({winner:newGs._trickWinner, pts:newGs._trickNet, trick:newGs._trickCards, isFinal:tp>=13});
      setPhase('trick_done');
    } else {
      setGs(newGs);
      setPhase('pass');
    }
  }, []);

  // ── Non-human play: local heuristic only ─────────────────────────────────
  const runComputerSeat = useCallback(async (currentGs, player) => {
    setBotBusy(true);
    setBotError(null);
    try {
      // Small delay so the UI has a moment to render the thinking indicator
      await new Promise(r => setTimeout(r, 320));
      const card = chooseHeuristicCard(currentGs, player);
      commitCard(currentGs, player, card);
    } catch(e) {
      setBotError(`Heuristik-Fehler: ${e.message}`);
    } finally {
      setBotBusy(false);
    }
  }, [commitCard]);

  // ── Auto-trigger non-human turns ───────────────────────────────────────────
  // Runs whenever phase becomes 'pass' and the current player is not human.
  useEffect(() => {
    if(phase !== 'pass' || !gs || botBusy) return;
    const cp = gs.currentPlayer;
    if(seatTypes[cp] === 'human') return;
    runComputerSeat(gs, cp);
  }, [phase, gs?.currentPlayer, seatTypes, botBusy, gs, runComputerSeat]);

  // ── Game flow helpers ──────────────────────────────────────────────────────
  const startGame = () => {
    setScores([0,0,0,0]); setRound(1); setBotError(null);
    const g = dealRound(Math.floor(Math.random()*4));
    setGs(g); setQuetschStep(0); setLastTrick(null);
    setQuetschReceived([[],[],[],[]]); setQuetschReviewQueue([]); setQuetschReviewPos(0);
    // Find first human quetsch step (bots auto-skip)
    const firstHuman = [0,1,2,3].find(i => !isBot[i]);
    if(firstHuman === undefined) {
      // All bots: auto-apply quetsch, start playing
      const autoGs = autoApplyAllQuetsch(g);
      setGs(autoGs); setPhase('pass'); setScreen('game');
    } else {
      setQuetschStep(firstHuman); setPhase('quetsch_pass'); setScreen('game');
    }
  };

  const autoApplyAllQuetsch = (g) => {
    const sels = g.hands.map(h => botQuetschPick(h));
    const newHands = g.hands.map(h=>[...h]);
    const toAdd = [[],[],[],[]];
    for(let i=0;i<4;i++){
      sels[i].forEach(card=>toAdd[(i+1)%4].push(card));
      sels[i].forEach(card=>{
        const idx=newHands[i].findIndex(c=>c.s===card.s&&c.v===card.v);
        if(idx>=0) newHands[i].splice(idx,1);
      });
    }
    for(let i=0;i<4;i++) newHands[i]=sortHand([...newHands[i],...toAdd[i]]);
    return {...g, hands:newHands, quetschPassedLeft:sels.map(sel=>[...sel])};
  };

  const confirmQuetschSelection = (selected) => {
    // Build selections array, auto-filling bots
    const newSels = gs.quetschSelections.map((s,i) =>
      i===quetschStep ? selected : (isBot[i] ? botQuetschPick(gs.hands[i]) : s)
    );

    // Find next human player who still needs to pick
    const nextHuman = [1,2,3].map(d=>(quetschStep+d)%4).find(i=>!isBot[i]&&newSels[i].length===0);

    if(nextHuman !== undefined) {
      setGs(prev=>({...prev,quetschSelections:newSels}));
      setQuetschStep(nextHuman);
      setPhase('quetsch_pass');
    } else {
      // All selections done — apply quetsch
      const finalSels = [0,1,2,3].map(i =>
        isBot[i] ? botQuetschPick(gs.hands[i]) : newSels[i]
      );
      const newHands = gs.hands.map(h=>[...h]);
      const toAdd = [[],[],[],[]];
      for(let i=0;i<4;i++){
        finalSels[i].forEach(card=>toAdd[(i+1)%4].push(card));
        finalSels[i].forEach(card=>{
          const idx=newHands[i].findIndex(c=>c.s===card.s&&c.v===card.v);
          if(idx>=0) newHands[i].splice(idx,1);
        });
      }
      for(let i=0;i<4;i++) newHands[i]=sortHand([...newHands[i],...toAdd[i]]);
      const received = toAdd.map(cards => sortHand(cards));
      const reviewQueue = [0,1,2,3].filter(i => !isBot[i]);
      setGs(prev=>({...prev,hands:newHands,quetschSelections:[[],[],[],[]],quetschPassedLeft:finalSels.map(sel=>[...sel])}));
      setQuetschReceived(received);
      setQuetschReviewQueue(reviewQueue);
      setQuetschReviewPos(0);
      setPhase(reviewQueue.length === 0 ? 'pass' : (reviewQueue.length === 1 ? 'quetsch_review' : 'quetsch_review_pass'));
    }
  };

  const playCard = (idx) => {
    if(phase!=='playing') return;
    const p = gs.currentPlayer;
    const hand = gs.hands[p];
    const valid = new Set(getValidIdxs(hand, gs.leadSuit));
    if(!valid.has(idx)) return;
    commitCard(gs, p, hand[idx]);
  };

  const afterQuetschReview = () => {
    const nextPos = quetschReviewPos + 1;
    if(nextPos < quetschReviewQueue.length) {
      setQuetschReviewPos(nextPos);
      setPhase('quetsch_review_pass');
    } else {
      setQuetschReviewQueue([]);
      setQuetschReviewPos(0);
      setPhase('pass');
    }
  };

  const afterTrick = () => {
    const finalTrick = lastTrick?.isFinal;
    setGs(prev=>({...prev,trick:[],leadSuit:null,currentPlayer:lastTrick.winner}));
    setLastTrick(null);
    setPhase(finalTrick ? 'round_done' : 'pass');
  };

  // Auto-advance after showing a completed trick briefly in the center.
  useEffect(() => {
    if (phase !== 'trick_done' || !lastTrick) return;
    const timer = setTimeout(() => afterTrick(), TRICK_DONE_AUTO_ADVANCE_MS);
    return () => clearTimeout(timer);
  }, [phase, lastTrick]);

  const afterRound = () => {
    const ns = scores.map((s,i)=>s+gs.roundPts[i]);
    if(round>=MAX) { setScores(ns); setScreen('gameover'); }
    else {
      setScores(ns); setRound(r=>r+1);
      const g = dealRound((gs.dealer+1)%4);
      const firstHuman = [0,1,2,3].find(i=>!isBot[i]);
      if(firstHuman===undefined) {
        setGs(autoApplyAllQuetsch(g)); setPhase('pass');
      } else {
        setGs(g); setQuetschStep(firstHuman); setPhase('quetsch_pass');
      }
      setLastTrick(null); setBotError(null);
      setQuetschReceived([[],[],[],[]]); setQuetschReviewQueue([]); setQuetschReviewPos(0);
    }
  };

  // ── ONLINE LOBBY ────────────────────────────────────────────────────────────
  if(screen==='online') return <OnlineLobby onBack={() => setScreen('welcome')} />;

  // ── WELCOME ────────────────────────────────────────────────────────────────
  if(screen==='welcome') return (
    <div style={{...bg,display:'flex',alignItems:'center',justifyContent:'center'}}>
      <div style={{width:'100%',maxWidth:440,padding:'0 24px',textAlign:'center'}}>
        <div style={{fontSize:56,marginBottom:10}}>🐷</div>
        <h1 style={{fontSize:42,fontWeight:'bold',letterSpacing:3,color:'#f4c430',margin:'0 0 6px'}}>Wuzz</h1>
        <p style={{color:'#6dbf8a',marginBottom:28,fontSize:14,letterSpacing:1}}>Lokales Stichspiel · 4 Spieler · {MAX} Runden · nur Heuristik-Bots</p>

        {/* Player setup */}
        <div style={{marginBottom:28,textAlign:'left'}}>
          {names.map((n,i)=>(
            <div key={i} style={{display:'flex',gap:8,alignItems:'center',marginBottom:10}}>
              <select value={seatTypes[i]} onChange={e=>setSeatTypes(ts=>ts.map((v,j)=>j===i?e.target.value:v))}
                style={{
                  width:126,flexShrink:0,
                  background:seatTypes[i]==='human'?'rgba(255,255,255,0.08)':'rgba(244,196,48,0.15)',
                  border:`1px solid ${seatTypes[i]==='human'?'rgba(255,255,255,0.15)':'rgba(244,196,48,0.5)'}`,
                  borderRadius:8,padding:'8px 7px',fontSize:13,cursor:'pointer',
                  color:seatTypes[i]==='human'?'white':'#f4c430',fontFamily:'Georgia,serif',
                }}>
                <option value="human">👤 Mensch</option>
                <option value="heuristic">🧠 Heuristik</option>
              </select>
              <input value={n} onChange={e=>setNames(ns=>ns.map((x,j)=>j===i?e.target.value:x))}
                style={{flex:1,background:'rgba(255,255,255,0.08)',border:'1px solid rgba(255,255,255,0.18)',borderRadius:8,padding:'9px 14px',color:'white',fontSize:16,outline:'none',fontFamily:'Georgia,serif'}}/>
              <span style={{fontSize:18,width:24,textAlign:'right',flexShrink:0}}>
                {seatTypes[i]==='human'?'👤':seatTypes[i]==='heuristic'?'🧠':'🤖'}
              </span>
            </div>
          ))}
        </div>



        <Btn onClick={startGame} full>Lokales Spiel starten ♠</Btn>
        <Btn onClick={() => setScreen('online')} full style={{marginTop:12}}>Online Lobby 🌐</Btn>
        <div style={{marginTop:18,fontSize:12,color:'rgba(255,255,255,0.28)',lineHeight:2.1}}>
          Stich +10 · Herzkarte −Wert · 🐷 −35 · Quetsch: 3 Karten nach links
        </div>
      </div>
    </div>
  );

  // ── GAME OVER ──────────────────────────────────────────────────────────────
  if(screen==='gameover'){
    const ranked=names.map((n,i)=>({n,s:scores[i],type:seatTypes[i]})).sort((a,b)=>b.s-a.s);
    const medals=['🥇','🥈','🥉','4.'];
    return (
      <div style={{...bg,display:'flex',alignItems:'center',justifyContent:'center'}}>
        <div style={{width:'100%',maxWidth:440,padding:'0 24px',textAlign:'center'}}>
          <div style={{fontSize:48,marginBottom:12}}>🏆</div>
          <h2 style={{fontSize:34,color:'#f4c430',marginBottom:6}}>Spielende!</h2>
          <p style={{color:'#6dbf8a',marginBottom:28,fontSize:14}}>Endstand nach {MAX} Runden</p>
          {ranked.map((p,r)=>(
            <div key={r} style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:'13px 20px',marginBottom:8,background:r===0?'rgba(244,196,48,0.12)':'rgba(255,255,255,0.05)',borderRadius:10,border:r===0?'1px solid rgba(244,196,48,0.35)':'1px solid rgba(255,255,255,0.06)'}}>
              <span style={{fontSize:18}}>{medals[r]} {p.type==='human'?'👤 ':p.type==='heuristic'?'🧠 ':'🤖 '}{p.n}</span>
              <span style={{color:'#f4c430',fontWeight:'bold',fontSize:22}}>{p.s}</span>
            </div>
          ))}
          <Btn onClick={()=>setScreen('welcome')} full style={{marginTop:28}}>Neues Spiel</Btn>
        </div>
      </div>
    );
  }

  if(!gs) return null;
  const cp = gs.currentPlayer;
  const runScores = scores.map((s,i)=>s+gs.roundPts[i]);

  const Header = () => (
    <div style={{background:'rgba(0,0,0,0.5)',padding:'10px 16px',display:'flex',justifyContent:'space-between',alignItems:'center',flexShrink:0}}>
      <span style={{color:'#f4c430',fontWeight:'bold',fontSize:17,letterSpacing:1}}>🐷 Wuzz</span>
      <span style={{color:'#6dbf8a',fontSize:13}}>Runde {round} / {MAX}</span>
    </div>
  );

  // ── QUETSCH: pass device ───────────────────────────────────────────────────
  if(phase==='quetsch_pass') {
    // Skip straight to select if this player is somehow human (should always be)
    return (
      <div style={{...bg,display:'flex',flexDirection:'column'}}>
        <Header/>
        <div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',padding:24}}>
          <div style={{textAlign:'center',maxWidth:360}}>
            <div style={{fontSize:48,marginBottom:14}}>🔄</div>
            <div style={{background:'rgba(244,196,48,0.1)',border:'1px solid rgba(244,196,48,0.3)',borderRadius:12,padding:'6px 18px',display:'inline-block',marginBottom:18,fontSize:13,color:'#f4c430',letterSpacing:0.5}}>
              QUETSCH — Schritt {quetschStep+1} von 4
            </div>
            <h2 style={{fontSize:30,color:'#f4c430',margin:'0 0 10px'}}>👤 {names[quetschStep]}</h2>
            <p style={{color:'#9dcfb0',marginBottom:36,fontSize:15,lineHeight:1.7}}>
              Gerät bitte an <strong style={{color:'white'}}>{names[quetschStep]}</strong> weitergeben.<br/>
              <span style={{fontSize:13,opacity:0.6}}>Wähle 3 Karten für <strong style={{color:'rgba(255,255,255,0.8)'}}>{names[(quetschStep+1)%4]}</strong>.</span>
            </p>
            <Btn onClick={()=>setPhase('quetsch_select')} full>Karten ansehen ✓</Btn>
          </div>
        </div>
      </div>
    );
  }

  if(phase==='quetsch_select') return (
    <QuetschSelect names={names} quetschStep={quetschStep}
      hand={gs.hands[quetschStep]} onConfirm={confirmQuetschSelection}/>
  );

  if(phase==='quetsch_review_pass') {
    const reviewPlayer = quetschReviewQueue[quetschReviewPos];
    return (
      <div style={{...bg,display:'flex',flexDirection:'column'}}>
        <Header/>
        <ScoreBar names={names} seatTypes={seatTypes} gs={gs} runScores={runScores} highlight={reviewPlayer}/>
        <div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',padding:24}}>
          <div style={{textAlign:'center',maxWidth:380}}>
            <div style={{width:72,height:72,borderRadius:'50%',background:'rgba(244,196,48,0.15)',border:'2px solid rgba(244,196,48,0.4)',display:'flex',alignItems:'center',justifyContent:'center',margin:'0 auto 20px',fontSize:32}}>🎁</div>
            <h2 style={{fontSize:30,color:'#f4c430',margin:'0 0 10px'}}>{names[reviewPlayer]}</h2>
            <p style={{color:'#9dcfb0',marginBottom:36,fontSize:15,lineHeight:1.7}}>
              Gerät bitte an <strong style={{color:'white'}}>{names[reviewPlayer]}</strong> weitergeben.<br/>
              <span style={{fontSize:13,opacity:0.6}}>Neue Quetsch-Karten ansehen — andere Spieler bitte nicht hinschauen.</span>
            </p>
            <Btn onClick={()=>setPhase('quetsch_review')} full>Neue Karten ansehen ✓</Btn>
          </div>
        </div>
      </div>
    );
  }

  if(phase==='quetsch_review') {
    const reviewPlayer = quetschReviewQueue[quetschReviewPos];
    const received = quetschReceived[reviewPlayer] ?? [];
    const handAfterQuetsch = gs.hands[reviewPlayer] ?? [];
    const fromPlayer = (reviewPlayer + 3) % 4;
    const moreReviews = quetschReviewPos + 1 < quetschReviewQueue.length;
    const wasReceived = card => received.some(c => sameCard(c, card));
    return (
      <div style={{...bg,display:'flex',flexDirection:'column'}}>
        <Header/>
        <ScoreBar names={names} seatTypes={seatTypes} gs={gs} runScores={runScores} highlight={reviewPlayer}/>
        <div style={{flex:1,overflowY:'auto',display:'flex',alignItems:'center',justifyContent:'center',padding:20}}>
          <div style={{textAlign:'center',maxWidth:560,width:'100%'}}>
            <div style={{fontSize:36,marginBottom:10}}>🎁</div>
            <h2 style={{fontSize:28,color:'#f4c430',margin:'0 0 8px'}}>Neue Karten aus dem Quetsch</h2>
            <p style={{color:'#9dcfb0',fontSize:14,lineHeight:1.6,margin:'0 0 18px'}}>
              {names[reviewPlayer]} hat diese Karten von <strong style={{color:'white'}}>{names[fromPlayer]}</strong> erhalten.
            </p>

            <div style={{textAlign:'left',marginBottom:18}}>
              <div style={{fontSize:12,color:'#f4c430',fontWeight:'bold',letterSpacing:0.8,margin:'0 0 8px 4px'}}>ERHALTEN</div>
              <div style={{display:'flex',gap:10,justifyContent:'center',flexWrap:'wrap',background:'rgba(0,0,0,0.22)',border:'1px solid rgba(255,255,255,0.07)',borderRadius:14,padding:'16px 12px'}}>
                {received.map(card=>(
                  <CardFace key={`${card.s}${card.v}`} card={card} highlighted/>
                ))}
              </div>
            </div>

            <div style={{textAlign:'left',marginBottom:24}}>
              <div style={{display:'flex',justifyContent:'space-between',alignItems:'center',gap:10,margin:'0 4px 8px'}}>
                <div style={{fontSize:12,color:'#f4c430',fontWeight:'bold',letterSpacing:0.8}}>DEINE HAND JETZT</div>
                <div style={{fontSize:11,color:'rgba(255,255,255,0.42)'}}>Neue Karten sind gelb markiert.</div>
              </div>
              <div style={{display:'flex',gap:7,justifyContent:'center',flexWrap:'wrap',background:'rgba(0,0,0,0.16)',border:'1px solid rgba(255,255,255,0.06)',borderRadius:14,padding:'12px'}}>
                {handAfterQuetsch.map(card=>(
                  <CardFace key={`${card.s}${card.v}`} card={card} size='sm' highlighted={wasReceived(card)}/>
                ))}
              </div>
            </div>

            <Btn onClick={afterQuetschReview} full>
              {moreReviews?'Weitergeben →':'Spiel starten →'}
            </Btn>
          </div>
        </div>
      </div>
    );
  }

  // ── PASS DEVICE (human turn) ───────────────────────────────────────────────
  if(phase==='pass') {
    if(isBot[cp]) {
      // Bot turn: show thinking screen (useEffect will trigger the API call)
      return (
        <div style={{...bg,display:'flex',flexDirection:'column'}}>
          <Header/>
          <ScoreBar names={names} seatTypes={seatTypes} gs={gs} runScores={runScores} highlight={cp}/>
          <PenaltyInfo penaltyPlayed={gs.penaltyPlayed} trick={gs.trick}/>
          <div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',flexDirection:'column',gap:16}}>
            <div style={{fontSize:64}}>🤖</div>
            <div style={{color:'#f4c430',fontSize:22,fontWeight:'bold'}}>{names[cp]} denkt…</div>
            {botError&&(
              <div style={{background:'rgba(192,57,43,0.2)',border:'1px solid rgba(192,57,43,0.5)',borderRadius:10,padding:'12px 20px',maxWidth:340,fontSize:13,color:'#ff9090',textAlign:'center'}}>
                {botError}<br/>
                <span style={{fontSize:11,opacity:0.7}}>Die Heuristik läuft lokal im Browser.</span><br/>
                <Btn onClick={()=>{setBotError(null);runComputerSeat(gs,cp);}} style={{marginTop:12,fontSize:14,padding:'8px 20px'}}>Nochmal versuchen</Btn>
              </div>
            )}
          </div>
        </div>
      );
    }
    // Human turn
    return (
      <div style={{...bg,display:'flex',flexDirection:'column'}}>
        <Header/>
        <ScoreBar names={names} seatTypes={seatTypes} gs={gs} runScores={runScores}/>
        <PenaltyInfo penaltyPlayed={gs.penaltyPlayed} trick={gs.trick}/>
        <div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',padding:24}}>
          <div style={{textAlign:'center',maxWidth:360}}>
            <div style={{width:72,height:72,borderRadius:'50%',background:'rgba(244,196,48,0.15)',border:'2px solid rgba(244,196,48,0.4)',display:'flex',alignItems:'center',justifyContent:'center',margin:'0 auto 20px',fontSize:32}}>📱</div>
            <h2 style={{fontSize:30,color:'#f4c430',margin:'0 0 10px'}}>{names[cp]}</h2>
            <p style={{color:'#9dcfb0',marginBottom:36,fontSize:15,lineHeight:1.7}}>
              Gerät bitte an <strong style={{color:'white'}}>{names[cp]}</strong> weitergeben.<br/>
              <span style={{fontSize:13,opacity:0.6}}>Andere Spieler – bitte nicht hinschauen!</span>
            </p>
            <Btn onClick={()=>setPhase('playing')} full>Meine Karten ansehen ✓</Btn>
          </div>
        </div>
      </div>
    );
  }

  // ── PLAYING ────────────────────────────────────────────────────────────────
  if(phase==='playing' || (phase==='trick_done' && lastTrick)){
    const isTrickPause = phase === 'trick_done' && lastTrick;
    const activePlayer = Number.isInteger(cp) ? cp : lastTrick?.winner;
    const hand  = isTrickPause ? [] : (gs.hands[activePlayer] ?? []);
    const valid = isTrickPause ? new Set() : new Set(getValidIdxs(hand, gs.leadSuit));
    const trickNo = isTrickPause ? gs.tricksPlayed : gs.tricksPlayed + 1;
    return (
      <div style={{...bg,display:'flex',flexDirection:'column'}}>
        <Header/>
        <ScoreBar names={names} seatTypes={seatTypes} gs={gs} runScores={runScores} highlight={isTrickPause ? undefined : activePlayer}/>
        <PenaltyInfo penaltyPlayed={gs.penaltyPlayed} trick={gs.trick}/>
        <div style={{flex:1,display:'flex',flexDirection:'column',alignItems:'center',justifyContent:'center',padding:'12px'}}>
          <div style={{background:'rgba(0,0,0,0.28)',borderRadius:16,border:'1px solid rgba(255,255,255,0.09)',padding:'14px 18px',width:'100%',maxWidth:400}}>
            <div style={{textAlign:'center',fontSize:12,color:'#6dbf8a',marginBottom:12,letterSpacing:0.5}}>
              Stich {trickNo} von 13
              {gs.leadSuit&&<span style={{marginLeft:8,color:'rgba(255,255,255,0.7)'}}>· Angespielt: {SYM[gs.leadSuit]}</span>}
            </div>
            <div style={{display:'flex',gap:16,justifyContent:'center',minHeight:92,alignItems:'flex-start',flexWrap:'wrap'}}>
              {gs.trick.length===0
                ?<span style={{color:'rgba(255,255,255,0.2)',fontSize:14}}>Noch keine Karte gespielt</span>
                :gs.trick.map(({player:p,card},i)=>(
                  <div key={i} style={{width:86,textAlign:'center',display:'flex',flexDirection:'column',alignItems:'center',flexShrink:0}}>
                    <div title={names[p]} style={{width:'100%',fontSize:10,color:'#6dbf8a',marginBottom:5,overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>
                      {seatTypes[p]==='human'?'👤':seatTypes[p]==='heuristic'?'🧠':'🤖'} {names[p]}
                    </div>
                    <CardFace card={card}/>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        {!isTrickPause&&(
          <div style={{flexShrink:0,background:'rgba(0,0,0,0.55)',borderTop:'1px solid rgba(255,255,255,0.08)',padding:'10px 14px 18px'}}>
            <div style={{textAlign:'center',marginBottom:8}}>
              <span style={{color:'#f4c430',fontWeight:'bold',fontSize:14}}>👤 {names[activePlayer]}s Hand</span>
              {gs.leadSuit&&<span style={{color:'#9dcfb0',fontSize:12,marginLeft:10}}>Bedienen: {SYM[gs.leadSuit]}</span>}
            </div>
            <div style={{display:'flex',flexWrap:'wrap',gap:7,justifyContent:'center'}}>
              {hand.map((card,idx)=>(
                <CardFace key={`${card.s}${card.v}`} card={card}
                  highlighted={valid.has(idx)} dimmed={!valid.has(idx)}
                  onClick={valid.has(idx)?()=>playCard(idx):null}/>
              ))}
            </div>
            <div style={{textAlign:'center',marginTop:6,fontSize:11,color:'rgba(255,255,255,0.28)'}}>
              Spielbare Karten tippen
            </div>
          </div>
        )}
        {botBusy&&!isTrickPause&&<BotThinking name={names[activePlayer]}/>}
      </div>
    );
  }

  // ── TRICK DONE ─────────────────────────────────────────────────────────────
  if(phase==='trick_done'&&lastTrick) return (
    <div style={{...bg,display:'flex',flexDirection:'column'}}>
      <Header/>
      <ScoreBar names={names} seatTypes={seatTypes} gs={gs} runScores={runScores}/>
      <PenaltyInfo penaltyPlayed={gs.penaltyPlayed} trick={gs.trick}/>
      <div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',padding:20}}>
        <div style={{textAlign:'center',maxWidth:420,width:'100%'}}>
          <div style={{fontSize:36,marginBottom:10}}>{lastTrick.pts>=0?'🎉':lastTrick.pts<=-30?'💀':'😬'}</div>
          {lastTrick.isFinal&&<div style={{fontSize:12,color:'#6dbf8a',letterSpacing:1,marginBottom:6}}>LETZTER STICH</div>}
          <h2 style={{fontSize:26,color:'#f4c430',margin:'0 0 8px'}}>
            {seatTypes[lastTrick.winner]==='human'?'👤 ':seatTypes[lastTrick.winner]==='heuristic'?'🧠 ':'🤖 '}{names[lastTrick.winner]} sticht!
          </h2>
          <p style={{fontSize:26,fontWeight:'bold',color:lastTrick.pts>=0?'#4ade80':'#f87171',margin:'0 0 20px'}}>
            {lastTrick.pts>=0?'+':''}{lastTrick.pts} Punkte
          </p>
          <div style={{display:'flex',gap:14,justifyContent:'center',flexWrap:'wrap',marginBottom:24,background:'rgba(0,0,0,0.2)',borderRadius:12,padding:'12px'}}>
            {lastTrick.trick.map(({player:p,card},i)=>(
              <div key={i} style={{width:72,textAlign:'center',display:'flex',flexDirection:'column',alignItems:'center',flexShrink:0}}>
                <div title={names[p]} style={{width:'100%',fontSize:10,color:'#6dbf8a',marginBottom:4,overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{names[p]}</div>
                <CardFace card={card} size='sm'/>
                <div style={{fontSize:10,color:cardPts(card)<0?'#f87171':'rgba(255,255,255,0.4)',marginTop:3}}>
                  {cardPts(card)!==0?(cardPts(card)>0?'+':'')+cardPts(card):''}
                </div>
              </div>
            ))}
          </div>
          <Btn onClick={afterTrick}>{lastTrick.isFinal?'Zur Auswertung →':'Nächster Stich →'}</Btn>
        </div>
      </div>
    </div>
  );

  // ── ROUND DONE ─────────────────────────────────────────────────────────────
  if(phase==='round_done') return (
    <div style={{...bg,display:'flex',flexDirection:'column'}}>
      <Header/>
      <div style={{flex:1,display:'flex',alignItems:'center',justifyContent:'center',padding:'20px'}}>
        <div style={{width:'100%',maxWidth:440,textAlign:'center'}}>
          <div style={{fontSize:36,marginBottom:12}}>📊</div>
          <h2 style={{fontSize:30,color:'#f4c430',margin:'0 0 4px'}}>Runde {round} beendet</h2>
          <p style={{color:'#6dbf8a',marginBottom:24,fontSize:14}}>
            {round<MAX?`Noch ${MAX-round} Runde${MAX-round>1?'n':''}`:'Das war die letzte Runde!'}
          </p>
          <div style={{background:'rgba(0,0,0,0.2)',borderRadius:12,border:'1px solid rgba(255,255,255,0.06)',overflow:'hidden',marginBottom:24}}>
            <div style={{display:'flex',justifyContent:'space-between',padding:'8px 18px',fontSize:11,color:'#6dbf8a',borderBottom:'1px solid rgba(255,255,255,0.06)',letterSpacing:0.5}}>
              <span>SPIELER</span>
              <div style={{display:'flex',gap:24}}><span>RUNDE</span><span style={{minWidth:44,textAlign:'right'}}>GESAMT</span></div>
            </div>
            {names.map((n,i)=>{
              const rp=gs.roundPts[i], ns=scores[i]+rp;
              return (
                <div key={i} style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:'11px 18px',background:i%2===0?'transparent':'rgba(255,255,255,0.025)'}}>
                  <span style={{fontSize:16}}>{seatTypes[i]==='human'?'👤 ':seatTypes[i]==='heuristic'?'🧠 ':'🤖 '}{n}</span>
                  <div style={{display:'flex',gap:24,alignItems:'center'}}>
                    <span style={{color:rp>=0?'#4ade80':'#f87171',fontWeight:'bold',minWidth:50,textAlign:'right',fontSize:16}}>{rp>=0?'+':''}{rp}</span>
                    <span style={{color:'#f4c430',minWidth:44,textAlign:'right',fontSize:18,fontWeight:'bold'}}>{ns}</span>
                  </div>
                </div>
              );
            })}
          </div>
          <Btn onClick={afterRound} full>
            {round<MAX?`Runde ${round+1} starten →`:'Ergebnis anzeigen 🏆'}
          </Btn>
        </div>
      </div>
    </div>
  );

  return null;
}
