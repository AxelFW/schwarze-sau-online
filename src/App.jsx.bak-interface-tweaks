  <button onClick={disabled?undefined:onClick} style={{
    background:disabled?'rgba(255,255,255,0.1)':'linear-gradient(135deg,#f4c430,#d4a017)',
    color:disabled?'rgba(255,255,255,0.3)':'#1a1a1a',
    border:'none',borderRadius:12,
    padding:full?'15px':'13px 36px',
    width:full?'100%':undefined,
    fontSize:17,fontWeight:'bold',cursor:disabled?'not-allowed':'pointer',
    fontFamily:'Georgia,serif',letterSpacing:0.3,
    boxShadow:disabled?'none':'0 2px 8px rgba(0,0,0,0.3)',
