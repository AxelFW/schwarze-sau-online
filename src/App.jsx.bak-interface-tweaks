        <div key={i} style={{flex:1,textAlign:'center',padding:'6px 3px',borderRight:i<3?'1px solid rgba(255,255,255,0.07)':'none',background:i===highlight?'rgba(244,196,48,0.08)':'transparent'}}>
          <div style={{fontSize:10,color:'#6dbf8a',overflow:'hidden',whiteSpace:'nowrap',textOverflow:'ellipsis',padding:'0 2px'}}>
