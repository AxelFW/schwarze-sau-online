NODE_ENV=production
ROOM_TTL_MS=1800000
BOT_DELAY_MS=650
VITE_LOCAL_BOT_DELAY_MS=650
TRICK_REVIEW_MS=1400
EXPIRY_SWEEP_MS=60000
DISCONNECTED_HUMAN_BOT_DELAY_MS=20000
# Start checking "Rest zu mir" with at most this many tricks remaining (2-13).
REST_CLAIM_MAX_TRICKS=3
# Easy-mode Bot-Tipps. Set VITE_ENABLE_EASY_MODE=false to hide the option in the lobby.
# Hidden URL access stays possible with ?easyMode=true, ?easy=true, or ?botTips=true.
# ENABLE_EASY_MODE=false is an optional server-side alias for hiding the option.
VITE_ENABLE_EASY_MODE=true
ENABLE_EASY_MODE=true
# Multiplies normal completed-trick display delays when "Schnelles Spiel" is enabled in the lobby.
# Does not affect REST_CLAIM_REVEAL_MS / Rest-zu-mir reveal timing.
# 0.62 means quick-game trick delays are 62% of the normal duration.
QUICK_GAME_DELAY_FACTOR=0.62

# Default match length in the lobby: 1 means 1 Rutsche / 4 Spiele.
DEFAULT_MATCH_RUNDEN=1
# Warn in server logs when one websocket payload exceeds this size. Set 0 to disable.
WS_PAYLOAD_WARN_BYTES=120000
